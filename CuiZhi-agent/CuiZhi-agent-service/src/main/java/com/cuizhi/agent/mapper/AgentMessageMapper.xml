<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cuizhi.agent.mapper.AgentMessageMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.cuizhi.agent.model.po.AiMessage">
        <id column="id" property="id" />
        <result column="session_id" property="sessionId" />
        <result column="role" property="role" />
        <result column="content" property="content" />
        <result column="modelName" property="modelName" />
        <result column="total_tokens" property="tokenCount" />
        <result column="latency_ms" property="latency_ms" />
        <result column="created_at" property="createdAt" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, session_id, role, content, modelName, total_tokens, latency_ms, created_at
    </sql>

</mapper>
